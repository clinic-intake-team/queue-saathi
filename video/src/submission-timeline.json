    },
    {
      "fromFrame": 1005,
      "toFrame": 1101,
      "text": "Aaj aap kis takleef ke liye aaye hain? Apne shabdon mein bataiye."
    },
    {
      "fromFrame": 1101,
      "toFrame": 1170,
      "text": "Mujhe actually 3 din se bukhaar hai"
    },
    {
      "fromFrame": 1170,
      "toFrame": 1238,
      "text": "aur gale mein bhi thoda dard hai."
    },
    {
      "fromFrame": 1455,
      "toFrame": 1496,
      "text": "Yeh takleef kab se hai?"
    },
    {
      "fromFrame": 1496,
      "toFrame": 1516,
      "text": "Three days."
    },
    {
      "fromFrame": 1785,
      "toFrame": 1862,
      "text": "Main abhi ke liye toh Dolo 650 le raha hoon."
    },
    {
      "fromFrame": 1862,
      "toFrame": 1988,
      "text": "Aapne bataya: Dolo 650. Kya yeh sahi hai?"
    },
    {
      "fromFrame": 2010,
      "toFrame": 2070,
      "text": "Haan, mujhe subah se seene mein dard hai"
    },
    {
      "fromFrame": 2070,
      "toFrame": 2130,
      "text": "aur bahut bhaari lag raha hai."
    },
    {
      "fromFrame": 2138,
      "toFrame": 2245,
      "text": "Yeh zaroori lag raha hai. Kripya abhi reception par bataiye."
    },
    {
      "fromFrame": 3030,
      "toFrame": 3090,
      "text": "Haan, mujhe subah se seene mein dard hai"
    },
    {
      "fromFrame": 3090,
