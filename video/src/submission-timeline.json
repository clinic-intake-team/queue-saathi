      "text": "confirm."
    },
    {
      "fromFrame": 2253,
      "toFrame": 2373,
      "text": "If an answer sounds like an emergency, the intake stops and the patient"
    },
    {
      "fromFrame": 2373,
      "toFrame": 2428,
      "text": "is sent to reception right away."
    },
    {
      "fromFrame": 2448,
      "toFrame": 2587,
      "text": "On the clinic computer, behind a simple PIN, the doctor sees the queue,"
    },
    {
      "fromFrame": 2587,
