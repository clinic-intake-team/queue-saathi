  "voiceovers": [
    {
      "file": "sub_vo01.wav",
      "text": "Patients wait in long queues… then forget what matters.",
      "caption": "Patients wait in long queues… then forget what matters.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 3.36,
      "number": 1,
      "source_hash": "f69c89b2da9068b170d663ad4f51da36982bdf3ffde92d5ad6e9fca0865ff398",
      "fromFrame": 3,
      "frames": 101
    },
    {
      "file": "sub_vo02.wav",
      "text": "बीपी की गोली लेता हूँ… नाम याद नहीं।",
      "caption": "BP ki goli leta hoon… naam yaad nahi.",
      "language": "hi-IN",
      "voice": "Avinash",
      "speed": 0.95,
      "duration": 2.778938,
      "number": 2,
      "source_hash": "1e2a4ed29132726f5de0a0edf08ef2a313b6e0c73721eb54f6db63ce1f6e800d",
      "fromFrame": 123,
      "frames": 84
    },
    {
      "file": "sub_vo03.wav",
      "text": "Meet Queue Saathi. While patients wait, they answer a few questions by voice, and the doctor gets a clean summary.",
      "caption": "Meet QueueSaathi. While patients wait, they answer a few questions by voice, and the doctor gets a clean summary.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 7.2,
      "number": 3,
      "source_hash": "f30b7f52d552cb748538dc1c300385d1fbc931c8bac6315c49edbb53f8739db9",
      "fromFrame": 228,
      "frames": 216
    },
    {
      "file": "sub_vo04.wav",
      "text": "Gnani's Timbre asks each question. Gnani's Prisma transcribes the answer. Then the answer is structured, every value is checked in code, and safety checks run on every reply.",
      "caption": "Gnani's Timbre asks each question. Gnani's Prisma transcribes the answer. Then the answer is structured, every value is checked in code, and safety checks run on every reply.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 11.04,
      "number": 4,
      "source_hash": "331fde0237dfc3fa18a51c95777a2c599b67fb793a20fa7d7c97e4564b79df6f",
      "fromFrame": 468,
      "frames": 332
    },
    {
      "file": "sub_vo05.wav",
      "text": "You can speak Hinglish, Hindi or English, however you naturally talk.",
      "caption": "You can speak Hinglish, Hindi or English, however you naturally talk.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 4.48,
      "number": 5,
      "source_hash": "0f15dc8e35fa65e5be5e3234a675e3fc2ef567a04ede2049c7e282a1a50681f4",
      "fromFrame": 828,
      "frames": 135
    },
    {
      "file": "sub_vo06.wav",
      "text": "It moves through short, simple questions, like how long the problem has lasted.",
      "caption": "It moves through short, simple questions, like how long the problem has lasted.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 5.04,
      "number": 6,
      "source_hash": "5738bb3ff17fa2361c2f87f2abd0a90a3d6ed85d211cbba4dec140f0e5b10ea3",
      "fromFrame": 1293,
      "frames": 152
    },
    {
      "file": "sub_vo07.wav",
      "text": "Medicine names are hard to hear, so Prisma gets a list of common Indian medicines, and Timbre reads every medicine back for the patient to confirm.",
      "caption": "Medicine names are hard to hear, so Prisma gets a list of common Indian medicines, and Timbre reads every medicine back for the patient to confirm.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 7.84,
      "number": 7,
      "source_hash": "3eefe3cf5ab69848209796ee1ee59187903fad99c08e9820ee6b6e44565b4a47",
      "fromFrame": 1533,
      "frames": 236
    },
    {
      "file": "sub_vo08.wav",
      "text": "If an answer sounds like an emergency, the intake stops and the patient is sent to reception right away.",
      "caption": "If an answer sounds like an emergency, the intake stops and the patient is sent to reception right away.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 5.84,
      "number": 8,
      "source_hash": "01363eb149eb17a6b1c9425c79f4fb79d6d80382efa48886c2f604a194de9f87",
      "fromFrame": 2253,
      "frames": 176
    },
    {
      "file": "sub_vo09.wav",
      "text": "On the clinic computer, behind a simple PIN, the doctor sees the queue, with urgent patients first.",
      "caption": "On the clinic computer, behind a simple PIN, the doctor sees the queue, with urgent patients first.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 6.08,
      "number": 9,
      "source_hash": "0a259f0c07cd86a206adbf176d12c16bd07181dbf3e75aa74a526a3665fc4fbd",
      "fromFrame": 2448,
      "frames": 183
    },
    {
      "file": "sub_vo10.wav",
      "text": "Each summary follows India's ABDM consultation sections, and every detail links back to the patient's own words.",
      "caption": "Each summary follows India's ABDM consultation sections, and every detail links back to the patient's own words.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 6.64,
      "number": 10,
      "source_hash": "2083af611593ba1c5f180d73e535fda28c85cac42ef669c3e559370b16221824",
      "fromFrame": 2778,
      "frames": 200
    },
    {
      "file": "sub_vo11.wav",
      "text": "We tested it on two hundred seventy-six scripted recordings from two speakers. Medicine name accuracy went from fifty-two to ninety-five percent. All four emergency sessions were flagged, and false alarms dropped from eleven of sixteen to one after we improved our validation.",
      "caption": "We tested it on 276 scripted recordings from 2 speakers. Medicine-name accuracy: 52% → 95%. All 4 emergency sessions were flagged, and false alarms dropped from 11/16 → 1/16 after we improved our validation.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 16.08,
      "number": 11,
      "source_hash": "26cb91b1b0988f338eb448811b7339199d1bed39678e2685af69e86e8a19168c",
      "fromFrame": 3498,
      "frames": 483
    },
    {
      "file": "sub_vo12.wav",
      "text": "It never guesses. It escalates when unsure. And it never makes a diagnosis.",
      "caption": "It never guesses. It escalates when unsure. And it never makes a diagnosis.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 5.04,
      "number": 12,
      "source_hash": "dd9a71db4c522f14b44cc0c3ef47eb802df186f366f9ecbe75c3c52462664259",
      "fromFrame": 4128,
      "frames": 152
    },
    {
      "file": "sub_vo13.wav",
      "text": "Queue Saathi. Your history, before you walk in.",
      "caption": "QueueSaathi. Your history, before you walk in.",
      "language": "en-IN",
      "voice": "Avinash",
      "speed": 1.0,
      "duration": 2.96,
      "number": 13,
      "source_hash": "af2116723c00e3558c32abb799167a1e953ab40f037b46c98b38937b97ace716",
      "fromFrame": 4323,
      "frames": 89
    }
  ],
  "captions": [
    {
