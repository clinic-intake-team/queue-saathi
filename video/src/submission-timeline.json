    },
    {
      "fromFrame": 4209,
      "toFrame": 4279,
      "text": "And it never makes a diagnosis."
    },
    {
      "fromFrame": 4323,
      "toFrame": 4336,
      "text": "QueueSaathi."
    },
    {
      "fromFrame": 4336,
